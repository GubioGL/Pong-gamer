{
  "seed": 2,
  "parameters": 4803,
  "model": "MLPQNet",
  "model_config": {
    "kind": "mlp",
    "n_obs": 6,
    "n_actions": 3,
    "hidden": [
      64,
      64
    ]
  },
  "dqn": {
    "total_steps": 100000,
    "gamma": 0.99,
    "lr": 0.0003,
