    "warmup": 1000,
    "train_every": 1,
    "target_update": 500,
    "eps_start": 1.0,
    "eps_end": 0.05,
    "eps_decay_steps": 40000,
    "double_dqn": true,
    "grad_clip": 10.0,
    "eval_every": 5000,
    "eval_episodes": 5
  }
